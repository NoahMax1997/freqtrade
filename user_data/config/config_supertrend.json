{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 2,
    "timeframe":"15m",
    "stake_currency": "USDT",
    "stake_amount": 30,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": false,
    "dry_run_wallet": 100,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "key_comment": "Removed sensitive key. Fill from local secrets only.",
        "secret": "",
        "secret_comment": "Removed sensitive secret. Fill from local secrets only.",
        "ccxt_config": {
            "enableRateLimit": true,
            "options": {
                "defaultType": "swap",
                "sandbox": false,
                "testnet": false,
                "adjustForTimeDifference": true
            },
            "apiKey": "",
            "apiKey_comment": "Removed sensitive API key. Fill from local secrets only.",
            "secret": "",
            "secret_comment": "Removed sensitive secret. Fill from local secrets only."
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "ZEC/USDT:USDT"
        ],
        "pair_blacklist": [
            "BNB/.*"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "pair_whitelist": [
                "ZEC/USDT:USDT"
            ]
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "",
        "token_comment": "Removed sensitive Telegram bot token.",
        "chat_id": "7866031576"
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "",
        "jwt_secret_key_comment": "Removed sensitive API auth secret.",
        "ws_token": "",
        "ws_token_comment": "Removed sensitive websocket token.",
        "CORS_origins": [],
        "username": "",
        "password": ""
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    }
}